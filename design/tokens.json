    "radius": {
        "$type": "dimension",
        "sm": { "$value": { "value": 6, "unit": "px" } },
        "md": { "$value": { "value": 8, "unit": "px" } },
        "lg": { "$value": { "value": 12, "unit": "px" } }
    },
    "typography": {
        "$type": "typography",
        "caption": {
            "$value": {
                "fontSize": { "value": 12, "unit": "px" },
                "lineHeight": { "value": 16, "unit": "px" }
            }
        },
        "small": {
            "$value": {
                "fontSize": { "value": 13, "unit": "px" },
                "lineHeight": { "value": 20, "unit": "px" }
            }
        },
        "body": {
            "$value": {
                "fontSize": { "value": 14, "unit": "px" },
                "lineHeight": { "value": 20, "unit": "px" }
            }
        },
        "reading": {
            "$value": {
                "fontSize": { "value": 15, "unit": "px" },
                "lineHeight": { "value": 26, "unit": "px" }
            }
        },
        "title": {
            "$value": {
                "fontSize": { "value": 16, "unit": "px" },
                "lineHeight": { "value": 24, "unit": "px" },
                "fontWeight": 600
            }
        },
        "heading": {
            "$value": {
                "fontSize": { "value": 18, "unit": "px" },
                "lineHeight": { "value": 26, "unit": "px" },
                "fontWeight": 600
            }
        },
        "display": {
            "$value": {
                "fontSize": { "value": 22, "unit": "px" },
                "lineHeight": { "value": 30, "unit": "px" },
                "fontWeight": 600
            }
        }
    },
    "motion": {
        "duration": {
            "$type": "duration",
            "fast": { "$value": { "value": 120, "unit": "ms" } },
            "base": { "$value": { "value": 150, "unit": "ms" } },
            "medium": { "$value": { "value": 220, "unit": "ms" } },
            "slow": { "$value": { "value": 280, "unit": "ms" } },
            "reveal": { "$value": { "value": 280, "unit": "ms" } }
        },
        "easing": {
            "$type": "cubicBezier",
            "enter": { "$value": [0.2, 0, 0, 1] },
            "exit": { "$value": [0.4, 0, 1, 1] },
            "move": { "$value": [0.2, 0, 0, 1] },
            "spring": { "$value": [0.2, 0, 0, 1] }
        }
    }
